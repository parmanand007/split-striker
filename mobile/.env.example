# Include the /api suffix.
#
# Prefer 127.0.0.1 over "localhost" for local backends (avoids IPv6 mismatches).
#
# Expo web:          http://127.0.0.1:8000/api  (LAN IPs are auto-rewritten to loopback)
# iOS Simulator:     http://127.0.0.1:8000/api
# Android Emulator:  same value — app rewrites 127.0.0.1/localhost → 10.0.2.2
# Physical device:   http://<YOUR_LAN_IP>:8000/api
# Production:        https://your-backend.onrender.com/api
#
# Backend (required for phones / Android emulator):
#   uvicorn main:app --reload --host 0.0.0.0 --port 8000
# Default `uvicorn ... --port 8000` only binds 127.0.0.1 — phones cannot connect.

EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
EXPO_PUBLIC_APP_ENV=development

